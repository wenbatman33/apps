            "mimeType": "text/plain",
            "text": "{\r\n\t\"type\"\t\t\t:\t\"SimulationThemes\",\r\n\t\r\n\t\"data\"\t\t\t:\t{\r\n\t\t\t\t\t\t\t\"schemes\"\t\t:\t[\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"blue\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"dark\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"light\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"space\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"chalk\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"notes\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t],\r\n\t\t\t\t\t\t\t\"leaderboard\"\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"title\"\t\t:\t\"9C3EB\"\r\n\t\t\t\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t},\r\n\t\r\n\t\"children\"\t\t:\t{\r\n\t\t\t\t\t\t\t\"blue\"\t\t\t:\t\"color/blue.model\",\r\n\t\t\t\t\t\t\t\"dark\"\t\t\t:\t\"color/dark.model\",\r\n\t\t\t\t\t\t\t\"light\"\t\t\t:\t\"color/light.model\",\r\n\t\t\t\t\t\t\t\"notes\"\t\t\t:\t\"notes/notes.model\",\r\n\t\t\t\t\t\t\t\"space\"\t\t\t:\t\"space/space.model\",\r\n\t\t\t\t\t\t\t\"chalk\"\t\t\t:\t\"chalk/chalk.model\",\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\"ambient\"\t\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"type\"\t\t\t:\t\"AmbientLight\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"color\"\t\t\t:\t\"#dfdfdf\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"intensity\"\t\t:\t1\r\n\t\t\t\t\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\"spotlight\"\t\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"type\"\t\t\t:\t\"SpotLight\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"color\"\t\t\t:\t\"#aaa\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"intensity\"\t\t:\t1,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"distance\"\t\t:\t25,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"decay\"\t\t\t:\t0,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"angle\"\t\t\t:\t20,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"penumbra\"\t\t:\t0.4,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"position\"\t\t:\t[0,20,0.75],\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"target\"\t\t:\t[0,-20,-1],\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"castShadow\"\t:\ttrue,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"shadow\"\t\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"radius\"\t:\t1,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"bias\"\t\t:\t0.0000000001,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"mapSize\" \t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"width\"  \t: \t1200,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"height\" \t: \t1200\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"camera\"\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"near\" \t\t:\t1,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"far\" \t\t:\t50,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"_focus\"\t:\t10,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\"fov\"\t\t:\t90\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"!visible\"\t\t:\tfalse\r\n\t\t\t\t\t\t\t\t\t\t\t\t},\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\"spotlight1\"\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"type\"\t\t\t:\t\"SpotLight\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"color\"\t\t\t:\t\"#aaa\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"intensity\"\t\t:\t0.4,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"distance\"\t\t:\t25,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"decay\"\t\t\t:\t0,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"angle\"\t\t\t:\t20,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"penumbra\"\t\t:\t0.4,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"position\"\t\t:\t[0,20,0.75],\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"target\"\t\t:\t[0,-20,-1],\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"castShadow\"\t:\tfalse,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"visible\"\t\t:\tfalse\r\n\t\t\t\t\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\"spotlight2\"\t:\t{\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"type\"\t\t\t:\t\"SpotLight\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"color\"\t\t\t:\t\"#aaa\",\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"intensity\"\t\t:\t0.6,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"distance\"\t\t:\t25,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"decay\"\t\t\t:\t0,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"angle\"\t\t\t:\t20,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"penumbra\"\t\t:\t0.4,\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"position\"\t\t:\t[0,20,0.75],\r\n\t\t\t\t\t\t\t\t\t\t\t\t\t\"target\"\t\t:\t[0,-20,-1],\r\n\t\t